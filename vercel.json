{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "images/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/dashboard",
      "dest": "/dashboard.html"
    },
    {
      "src": "/members",
      "dest": "/members.html"
    },
    {
      "src": "/party",
      "dest": "/party.html"
    },
    {
      "src": "/auction",
      "dest": "/auction.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
